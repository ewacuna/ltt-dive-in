{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ltt-dive-in/static-image-cluster",
    "title": "Static Image Cluster",
    "category": "ltt-blocks",
    "icon": "format-gallery",
    "description": "Editorial image cluster with gallery, hero, side-by-side, and inspired variants.",
    "keywords": ["gallery", "images", "editorial", "lightbox"],
    "textdomain": "ltt-dive-in",
    "style": "ltt-dive-in-static-image-cluster",
    "editorStyle": "ltt-dive-in-static-image-cluster",
    "viewScript": "ltt-dive-in-static-image-cluster",
    "acf": {
        "mode": "preview",
        "renderTemplate": "template-parts/blocks/static-image-cluster.php"
    },
    "attributes": {
        "align": { "type": "string", "default": "full" }
    },
    "supports": {
        "align": ["full"],
        "anchor": true,
        "customClassName": false,
        "html": false,
        "multiple": true
    }
}
