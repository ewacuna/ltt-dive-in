{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ltt-dive-in/content-module",
  "title": "Content Module",
  "category": "ltt-blocks",
  "icon": "align-wide",
  "description": "Text-led content layouts for page sections.",
  "keywords": [ "content", "copy", "stats", "newsletter", "comparison" ],
  "textdomain": "ltt-dive-in",
  "style": "ltt-dive-in-content-module",
  "script": "ltt-dive-in-content-module",
  "editorStyle": [ "ltt-dive-in-content-module", "ltt-dive-in-testimonials" ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "template-parts/blocks/content-module.php"
  },
  "attributes": {
    "align": { "type": "string", "default": "full" }
  },
  "supports": {
    "align": [ "full" ],
    "anchor": true,
    "customClassName": false,
    "html": false,
    "multiple": true
  }
}
