{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ltt-dive-in/story-module",
  "title": "Story Module",
  "category": "ltt-blocks",
  "icon": "welcome-write-blog",
  "description": "Blog post sections from the Blog Templates design.",
  "keywords": [ "blog", "story", "post", "tip" ],
  "textdomain": "ltt-dive-in",
  "editorStyle": "ltt-dive-in-story-module-editor",
  "acf": {
    "mode": "preview",
    "renderTemplate": "template-parts/blocks/story-module.php"
  },
  "attributes": {
    "align": { "type": "string", "default": "full" }
  },
  "supports": {
    "align": [ "full" ],
    "anchor": true,
    "customClassName": false,
    "html": false,
    "multiple": true
  }
}
