{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "background", "name": "Background", "color": "#f7f8fa" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "text", "name": "Text", "color": "#172033" },
        { "slug": "muted", "name": "Muted", "color": "#5f6878" },
        { "slug": "primary", "name": "Primary", "color": "#1457d9" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Gotham HTF', 'Avenir Next', Avenir, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "Gotham HTF",
          "slug": "sans"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "lineHeight": "1.65"
    }
  }
}
